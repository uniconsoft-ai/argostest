{
  "hosting": {
    "site": "argostest",
    "public": "static",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/__pycache__/**",
      "exports/**"
    ],
    "redirects": [
      {
        "source": "**",
        "destination": "https://argostest.onrender.com",
        "type": 302
      }
    ]
  }
}